{
  "tools": [
    {
      "name": "get_bible_verse",
      "description": "查詢指定的聖經經文。支援單節、多節、節範圍查詢。\n    \n    Args:\n        book: 經卷名稱（中文或英文縮寫，如：約、John、創世記、Genesis）\n        chapter: 章數\n        verse: 節數（支援格式：'1', '1-5', '1,3,5', '1-2,5,8-10'）。若不提供則返回整章\n        version: 聖經版本代碼（預設：unv）\n        include_strong: 是否包含 Strong's Number（預設：false）\n        use_simplified: 是否使用簡體中文（預設：false）\n    ",
      "inputSchema": {
        "properties": {
          "book": {
            "title": "Book",
            "type": "string"
          },
          "chapter": {
            "title": "Chapter",
            "type": "integer"
          },
          "verse": {
            "default": null,
            "title": "Verse",
            "type": "string"
          },
          "version": {
            "default": "unv",
            "title": "Version",
            "type": "string"
          },
          "include_strong": {
            "default": false,
            "title": "Include Strong",
            "type": "boolean"
          },
          "use_simplified": {
            "default": false,
            "title": "Use Simplified",
            "type": "boolean"
          }
        },
        "required": [
          "book",
          "chapter"
        ],
        "title": "get_bible_verseArguments",
        "type": "object"
      },
      "outputSchema": {
        "properties": {
          "result": {
            "title": "Result",
            "type": "string"
          }
        },
        "required": [
          "result"
        ],
        "title": "get_bible_verseOutput",
        "type": "object"
      }
    },
