"next":{"book":"","bid":43,"engs":"John","chap":3,"sec":22},
"record":[{"title":"\u7ea6\u7ff0\u798f\u97f3 3\u7ae01\u8282 \u5230 3\u7ae021\u8282",
"book_name":"\u4fe1\u671b\u7231\u7ad9\u6ce8\u91ca",
"com_text":"    \uff08\u4e8c\uff09\u8036\u7a23\u4e0e\u5c3c\u54e5\u5e95\u6bcd #3:1-21|\r\n          1.\u5c3c\u54e5\u5e95\u6bcd\u6765\u8bbf\u4e0e\u5176\u5bf9\u8036\u7a23\u7684\u8ba4\u8bc6#3:1-2|\r\n           (1)\u5c3c\u54e5\u5e95\u6bcd\u7684\u80cc\u666f\uff1a\u72b9\u592a\u4eba\u3001\u6cd5\u5229\u8d5b\u4eba\u3001\u5b98#3:1|\uff0c\u8001\u4eba#3:4|\uff0c\r\n              \u6709\u94b1\u4eba\uff08\u4f9d\u636e#\u7ea6 19:39|\u8bb0\u8f7d\uff0c\u6709\u80fd\u529b\u63d0\u4f9b\u5927\u91cf\u9999\u6599\u7684\u4eba\u5fc5\u7136\u6709\r\n              \u94b1\uff09\uff0c\u72b9\u592a\u4eba\u7684\u8001\u5e08\u3002#3:10|\r\n              \u25cf\u300c\u6cd5\u5229\u8d5b\u4eba\u300d\uff1aSNG05330\uff0c\u5b57\u4e49\u662f\u300c\u5206\u79bb\u8005\u300d\uff0c\u5f53\u4ee3\u6cd5\u5229\u8d5b\u4eba\u7684\r\n                              \u4eba\u6570\u5927\u7ea6\u6709\u516d\u5343\uff0c\u6563\u5e03\u5728\u6574\u4e2a\u5df4\u52d2\u65af\u5766\u3002\u4ed6\u4eec\u662f\u4f1a\r\n                              \u5802\u91cc\u7684\u6559\u5e08\uff0c\u4eba\u4eec\u5fc3\u76ee\u4e2d\u7684\u5b97\u6559\u6977\u6a21\uff0c\u81ea\u547d\u662f\u5f8b\u6cd5\r\n                              \u7684\u62a4\u536b\u8005\uff0c\u76d1\u7ba1\u4eba\u4eec\u6b63\u786e\u7684\u9075\u884c\u5f8b\u6cd5\u3002\u4ed6\u4eec\u8ba4\u4e3a\u4f20\r\n                              \u7edf\u4e0a\u5bf9\u5f8b\u6cd5\u7684\u89e3\u91ca\u548c\u89c4\u6761\uff0c\u5177\u6709\u5b9e\u8d28\u4e0a\u548c\u5723\u7ecf\u540c\u7b49\r\n                              \u7684\u6743\u5a01\u3002\r\n              \u25cf\u300c\u5c3c\u54e5\u5e95\u6bcd\u300d\uff1a\u5b57\u4e49\u662f\u300c\u5f81\u670d\u8005\u300d\u3002\r\n              \u25cf\u72b9\u592a\u4eba\u7684\u300c\u5b98\u300d\uff1aSNH00758\uff0c\u300c\u7edf\u6cbb\u8005\u300d\u3001\u300c\u9886\u8896\u300d\u3001\u300c\u5b98\u5458\u300d\r\n                                \u3002\r\n              \u25ce\u300c\u72b9\u592a\u4eba\u7684\u5b98\u300d\uff1a\u5373\u300c\u72b9\u592a\u516c\u4f1a\u7684\u6210\u5458\u300d\u3002\u300c\u72b9\u592a\u516c\u4f1a\u300d\u7531\u5927\u796d\r\n                                \u53f8\u62c5\u4efb\u4e3b\u5e2d\uff0c\u6709\u4e03\u5341\u4e2a\u6210\u5458\u3002\r\n              \u25ce\u8fd9\u6837\u6709\u94b1\u3001\u6709\u9053\u5fb7\u77e5\u8bc6\u7684\u4eba\u8fd8\u6765\u627e\u8036\u7a23\uff0c\u800c\u7531\u8036\u7a23\u540e\u6765\u4e0e\u4ed6\u7684\u5bf9\r\n                \u8bdd\uff0c\u53ef\u4ee5\u77e5\u9053\u5c3c\u54e5\u5e95\u6bcd\u771f\u6b63\u7684\u95ee\u9898\u662f\u6ca1\u6709\u628a\u63e1\u8fdb\u795e\u7684\u56fd\uff0c\u8fd9\u5c82\u4e0d\r\n                \u4ee4\u6211\u4eec\u4fa7\u76ee\uff1f\r\n\r\n           (2)\u5c3c\u54e5\u5e95\u6bcd\u5bf9\u8036\u7a23\u7684\u8ba4\u8bc6\uff1a\u7531\u795e\u90a3\u91cc\u6765\u4f5c\u8001\u5e08\u7684\u3002\u4ed6\u8fd9\u6837\u8ba4\u5b9a\u7684\u7406\u7531\r\n              \u662f\uff1a\u795e\u8ff9\u8bc1\u660e\u4e86\u8036\u7a23\u7684\u8eab\u4efd\u3002#3:2|\r\n              \u25cf\u300c\u62c9\u6bd4\u300d\uff1aSNG04461\uff0c\u300c\u5e08\u7236\u300d\u3001\u300c\u72b9\u592a\u4eba\u5bf9\u8001\u5e08\u7684\u5c0a\u79f0\u300d\u3002\r\n              \u25cf\u300c\u5e08\u5085\u300d\uff1aSNG01320\uff0c\u300c\u6559\u5e08\u300d\u3001\u300c\u6559\u5bfc\u6709\u5173\u795e\u7684\u4e8b\u53ca\u4eba\u7684\u8d23\u4efb\r\n                          \u7684\u4eba\u300d\u3002\r\n              \u25cf\u300c\u795e\u8ff9\u300d\uff1aSNG04592\uff0c\u300c\u8bb0\u53f7\u300d\u3001\u300c\u8868\u5fb5\u300d\u3002\u539f\u6587\u662f\u590d\u6570\u578b\u6001\uff0c\r\n                          \u663e\u89c1\u5f53\u65f6\u8036\u7a23\u5df2\u7ecf\u516c\u5f00\u884c\u8fc7\u4e0d\u5c11\u795e\u8ff9\uff0c\u4f46\u7ea6\u7ff0\u798f\u97f3\u5e76\r\n                          \u6ca1\u6709\u8bb0\u8f7d\u3002\r\n              \u25ce\u5c3c\u54e5\u5e95\u6bcd\u662f\u8bf4\u300c\u6211\u4eec\u300d\u77e5\u9053\uff0c\u8868\u793a\u8bb8\u591a\u4e0e\u4ed6\u6709\u4e00\u540c\u8eab\u4efd\u5730\u4f4d\u7684\u6cd5\r\n                \u5229\u8d5b\u4eba\u4eec\u4e5f\u90fd\u77e5\u9053\u8036\u7a23\u662f\u7531\u4e0a\u5e1d\u90a3\u91cc\u6765\u7684\u3002\u7136\u800c\u540e\u6765\u6b63\u662f\u8fd9\u4e00\u7fa4\r\n                \u4eba\u5bb3\u6b7b\u8036\u7a23\u3002\u662f\u4e0d\u662f\u6211\u4eec\u6240\u77e5\u7684\u8ddf\u6211\u4eec\u6240\u505a\u7684\u5e38\u5e38\u662f\u4e0d\u4e00\u6837\uff1f\r\n              \u25ce\u5c3c\u54e5\u5e95\u6bcd\u56e0\u4e3a\u8036\u7a23\u7684\u795e\u8ff9\u8ba4\u5b9a\u8036\u7a23\u662f\u7531\u4e0a\u5e1d\u90a3\u91cc\u6765\u7684\uff0c\u4f46\u8fd9\u4e00\u6bb5\r\n                \u524d\u7684#2:23-25|\uff0c\u6b63\u597d\u8bf4\u660e\u8036\u7a23\u5e76\u4e0d\u4fe1\u8d56\u6301\u8fd9\u6837\u4fe1\u4ef0\uff08\u56e0\u795e\u8ff9\u4fe1\r\n                \u8036\u7a23\uff09\u7684\u4eba\u3002\r\n\r\n           (3)\u5c3c\u54e5\u5e95\u6bcd\u591c\u95f4\u6765\u89c1\u8036\u7a23\u3002 #3:2|\r\n              \u25ce\u7406\u7531\u53ef\u80fd\u662f\u56e0\u4e3a\u6015\u4eba\u8bf4\u95f2\u8bdd\uff0c\u6216\u8005\u662f\u4ed6\u8ba4\u4e3a\u987b\u8981\u4e0e\u8036\u7a23\u957f\u8c08\uff0c\u56e0\r\n                \u6b64\u9009\u62e9\u591c\u95f4\u6765\u627e\u8036\u7a23\u3002\r\n\r\n          2.\u8036\u7a23\u8bf4\u660e\u4eba\u5fc5\u987b\u91cd\u751f\u624d\u80fd\u89c1\u795e\u7684\u56fd\uff0c\u800c\u5c3c\u54e5\u5e95\u6bcd\u8d28\u7591\u91cd\u751f\u7684\u53ef\u80fd\u6027\u3002\r\n            #3:3-4|\r\n            \u25cf\u300c\u5b9e\u5b9e\u5728\u5728\u300d\uff1aSNG00281+SNG00281\uff0c\u300c\u963f\u4eec\u300d\u3001\u300c\u963f\u4eec\u300d\u3002\r\n            \u25cf\u300c\u91cd\u751f\u300d\uff1aSNG00509\uff0c\u6709\u300c\u4ece\u4e0a\u5934\u800c\u751f\u300d\u3001\u300c\u518d\u6b21\u751f\u300d\u4e24\u79cd\u542b\u4e49\u3002\r\n            \u25cf\u300c\u89c1\u300d\u795e\u7684\u56fd\uff1aSNG03708\uff0c\u300c\u770b\u89c1\u300d\u3001\u300c\u4f53\u9a8c\u300d\u3001\u300c\u7ecf\u5386\u300d\u3002\r\n            \u25cf\u795e\u7684\u300c\u56fd\u300d\uff1aSNG00932\uff0c\u300c\u738b\u6743\u300d\u3001\u300c\u738b\u56fd\u300d\u3002\r\n            \u25cf\u300c\u795e\u7684\u56fd\u300d\uff1a\u6307\u300c\u4e0a\u5e1d\u7684\u7edf\u6cbb\u6743\u548c\u7248\u56fe\u300d\u3002\r\n            \u25ce\u6b64\u5904\u300c\u89c1\u795e\u7684\u56fd\u300d\u4e0e#3:5|\u7684\u300c\u8fdb\u795e\u7684\u56fd\u300d\u610f\u4e49\u5e94\u8be5\u662f\u4e00\u81f4\u7684\u3002\r\n            \u25ce\u5c3c\u54e5\u5e95\u6bcd\u663e\u7136\u9009\u62e9\u300c\u518d\u6b21\u751f\u300d\u7684\u6db5\u4e49\uff0c\u56e0\u6b64\u76f4\u63a5\u8d28\u7591\u518d\u4e00\u6b21\u751f\u51fa\u6765\r\n              \u7684\u53ef\u80fd\u6027\uff0c\u4f46\u8036\u7a23\u663e\u7136\u662f\u91c7\u300c\u4ece\u4e0a\u5934\u800c\u751f\u300d\u7684\u610f\u601d\u3002\r\n\r\n          3.\u8036\u7a23\u8868\u660e\u91cd\u751f\u5c31\u662f\u7531\u6c34\u548c\u7075\u751f\u3002 #3:5-6|\r\n            \u25cf\u6c34\u548c\u300c\u5723\u7075\u300d\u751f\uff1aSNG04151\uff0c\u300c\u98ce\u300d\u3001\u300c\u7075\u300d\u3002\u7531\u4e0a\u4e0b\u6587\u53ef\u4ee5\u770b\u51fa\r\n                              \u6b64\u5904\u6307\u7684\u5e94\u8be5\u662f\u300c\u795e\u7684\u7075\u300d\u3001\u300c\u5723\u7075\u300d\u3002\r\n            \u25ce\u300c\u6c34\u300d\uff1a\u53ef\u80fd\u6709\u4ee5\u4e0b\u51e0\u79cd\u89e3\u91ca\r\n                      (1)\u65bd\u6d17\u7ea6\u7ff0\u7684\u6d17\u793c\u3002\r\n                      (2)\u8089\u8eab\u7684\u51fa\u751f\uff08\u300c\u6c34\u300d\u6307\u7684\u662f\u300c\u7f8a\u6c34\u300d\uff0c\u8fd9\u662f\u52a0\u5c14\u6587\u7684\r\n                                    \u770b\u6cd5\uff09\u3002\r\n                      (3)\u4fe1\u5fc3\u3002\r\n                      (4)\u795e\u7684\u9053\uff08#\u5f17 5:25-26|\uff09\u3002\r\n                      (5)\u6307\u57fa\u7763\u5f92\u7684\u6d17\u793c\uff08\u8fd9\u662f\u9a6c\u4e01\u8def\u5fb7\u7684\u770b\u6cd5\uff09\u3002\r\n                      (6)\u6c34\u5c31\u662f\u5723\u7075\uff0c\u539f\u6587\u7684\u300c\u548c\u300d\u4e5f\u53ef\u4ee5\u7ffb\u8bd1\u6210\u300c\u5c31\u662f\u300d\u3002\r\n                      (7)\u6d01\u51c0\uff08\u6cd5\u5229\u8d5b\u4eba\u7528\u6c34\u6d01\u51c0\u7684\u793c\u4eea\uff09\u3002\r\n            \u25ce\u8003\u8651\u5230\u5c3c\u54e5\u5e95\u6bcd\u5f53\u65f6\u6240\u542c\u89c1\u7684\u610f\u4e49\uff0c\u4ee5(1)\u3001(6)\u3001(7)\u6bd4\u8f83\u6709\u53ef\r\n              \u80fd\u3002\r\n\r\n          4.\u8036\u7a23\u8bf4\u660e\u6211\u4eec\u53ef\u4ee5\u611f\u89c9\u91cd\u751f\u7684\u5f71\u54cd\u529b\u5374\u65e0\u6cd5\u4e86\u89e3\u91cd\u751f\u7684\u7ec6\u8282\u3002\r\n            #3:7-9|\r\n            \u25cf\u300c\u5fc5\u987b\u300d\u91cd\u751f\uff1aSNG01163\uff0c\u300c\u4e00\u5b9a\u300d\u3001\u300c\u7406\u5f53\u300d\u3002\r\n            \u25cf\u300c\u98ce\u300d\uff1aSNG04151\uff0c\u539f\u6587\u8ddf\u300c\u7075\u300d\u5b57\u662f\u540c\u4e00\u4e2a\u5b57\u3002\r\n\r\n          5.\u8036\u7a23\u611f\u53f9\u5c3c\u54e5\u5e95\u6bcd\u7684\u65e0\u6cd5\u7406\u89e3\uff0c\u5e76\u8bf4\u660e\u81ea\u5df1\u6240\u8bf4\u7684\u662f\u771f\uff0c\u800c\u4e14\u662f\u4eba\u53ef\r\n            \u4ee5\u9886\u609f\u7684\u3002 #3:10-12|\r\n            \u25cf\u300c\u5148\u751f\u300d\uff1aSNG01320\uff0c\u300c\u6559\u5e08\u300d\u3001\u300c\u6559\u5bfc\u6709\u5173\u795e\u7684\u4e8b\u53ca\u4eba\u7684\u8d23\u4efb\r\n                        \u7684\u4eba\u300d\uff0c\u6b64\u5b57\u524d\u6709\u5b9a\u51a0\u8bcd\uff0c\u6307\u5c3c\u54e5\u5e95\u6bcd\u662f\u6709\u5b98\u4f4d\u7684\u6559\r\n                        \u5e08\uff0c\u800c\u4e0d\u662f\u4e00\u822c\u4eba\u79c1\u4e0b\u8ba4\u53ef\u7684\u8001\u5e08\u3002\r\n            \u25cf\u300c\u6211\u4eec\u300d\uff1a\u53ef\u80fd\u662f\u5305\u542b\u300c\u95e8\u5f92\u548c\u8036\u7a23\u300d\u3002\r\n\r\n          6.\u9664\u4e86\u8036\u7a23\u4e4b\u5916\uff0c\u6ca1\u6709\u4eba\u5347\u8fc7\u5929\uff0c\u6469\u897f\u5728\u65f7\u91ce\u600e\u6837\u4e3e\u94dc\u86c7\uff0c\u8036\u7a23\u4e5f\u8981\u88ab\r\n            \u4e3e\u8d77\u6765\uff0c\u53eb\u4e00\u5207\u4fe1\u8036\u7a23\u7684\u4eba\u5f97\u6c38\u751f\u3002#3:13-15|\r\n            \u25cf\u300c\u9664\u4e86\u4ece\u5929\u964d\u4e0b\u3001\u4ecd\u65e7\u5728\u5929\u300d\uff1a\u6709\u4e9b\u6284\u672c\u4ec5\u6709\u300c\u9664\u4e86\u4ece\u5929\u964d\u4e0b\u300d\u3002\r\n                                          \u6ca1\u6709\u300c\u4ecd\u65e7\u5728\u5929\u300d\u3002\r\n            \u25cf\u300c\u4e3e\u86c7\u300d\uff1a\u53c2\u8003#\u6c11 21:5-9|\uff0c\u6469\u897f\u4e3e\u94dc\u86c7\uff0c\u8ba9\u88ab\u706b\u86c7\u54ac\r\n                        \u4f24\u7684\u767e\u59d3\u53ef\u4ee5\u4ef0\u671b\u94dc\u86c7\u5f97\u751f\u3002\u8fd9\u94dc\u86c7\u540e\u6765\u88ab\u5e0c\u897f\u5bb6\u9500\u6bc1\r\n                        #\u738b\u4e0b 18:4|\u3002\r\n            \u25cf\u300c\u5fc5\u300d\u7167\u6837\uff1aSNG01163\uff0c\u300c\u4e00\u5b9a\u300d\u3001\u300c\u7406\u5f53\u300d\u3002\r\n            \u25cf\u4e00\u5207\u300c\u4fe1\u300d\u4ed6\uff1aSNG04100\uff0c\u300c\u4fe1\u9760\u300d\u3001\u300c\u5c06\u4e00\u4ef6\u4e8b\u4ea4\u6258\u7ed9\u67d0\u4eba\u300d\u3002\r\n            \u25cf#3:15|\u6709\u4e00\u4e2aSNG01722\uff0c\u6ca1\u6709\u88ab\u548c\u5408\u672c\u7ffb\u8bd1\u51fa\u6765\u3002\u8fd9\u4e00\u8282\u7684\u610f\u4e49\u5e94\r\n              \u8be5\u662f\u300c\u4f7f\u5f97\u6240\u6709\u76f8\u4fe1\u7684\u4eba\uff0c\u5728\u4ed6\u91cc\u9762\u6709\u6c38\u751f\u300d\u3002\r\n            \u25ce\u300c\u8036\u7a23\u88ab\u4e3e\u300d\uff1a\u5e94\u8be5\u662f\u6307\u8036\u7a23\u88ab\u9489\u5341\u5b57\u67b6\u7684\u4e8b\u60c5\u3002\u800c\u4eba\u5f97\u6c38\u751f\u7684\u5fc5\r\n                            \u8981\u6761\u4ef6\u662f\u4fe1\u9760\u88ab\u9489\u5341\u5b57\u67b6\u7684\u8036\u7a23\u3002\r\n\r\n          7.\u4e0a\u5e1d\u7231\u4e16\u4eba\uff0c\u5c06\u72ec\u751f\u5b50\u8036\u7a23\u8d50\u7ed9\u4eba\uff0c\u53eb\u4fe1\u8036\u7a23\u7684\u4e0d\u81f4\u706d\u4ea1\uff0c\u53cd\u5f97\u6c38\u751f\r\n            \u3002 #3:16|\r\n            \u25cf\u300c\u4e16\u4eba\u300d\uff1aSNG02889\uff0c\u300c\u4e16\u754c\u300d\uff0c\u4e5f\u8bb8\u5305\u62ec\u6240\u6709\u7684\u53d7\u9020\u7269\u3002\r\n            \u25cf\u300c\u6c38\u751f\u300d\uff1aSNG02222+SNG00166\uff0c\u300c\u6c38\u8fdc\u7684\u751f\u547d\u300d\u3002\r\n            \u25ce#3:16-21|\uff0c\u5230\u5e95\u662f\u7ea6\u7ff0\u7684\u8bc4\u8bba\u8fd8\u662f\u8036\u7a23\u5bf9\u5c3c\u54e5\u5e95\u6bcd\u7684\u8868\u767d\uff0c\u5e76\u4e0d\r\n              \u80fd\u786e\u5b9a\u3002\u7ea6\u7ff0\u798f\u97f3\u5e38\u5e38\u6709\u8fd9\u4e00\u7c7b\u96be\u4ee5\u786e\u5b9a\u7684\u7ecf\u6587\u5b58\u5728\u3002\u4e3b\u8981\u662f\u56e0\u4e3a\r\n              \u6ca1\u6709\u660e\u786e\u7684\u65b9\u6cd5\u53ef\u4ee5\u533a\u5206\u5230\u5e95\u90a3\u4e00\u6bb5\u8bdd\u662f\u8036\u7a23\u7684\u8bdd\u8fd8\u662f\u7ea6\u7ff0\u7684\u611f\u8a00\r\n              \u3002\u867d\u7136\u5982\u6b64\uff0c\u5bf9\u6574\u4f53\u610f\u4e49\u7684\u5f71\u54cd\u4e0d\u5927\u3002\r\n\r\n          8.\u795e\u513f\u5b50\u964d\u4e16\u76ee\u7684\u4e3b\u8981\u4e0d\u662f\u8981\u5b9a\u4e16\u4eba\u7684\u7f6a\uff0c\u800c\u662f\u5e0c\u671b\u4e16\u4eba\u56e0\u795e\u5b50\u5f97\u6551\u3002\r\n            #3:17|\r\n            \u25cf\u300c\u5b9a....\u7f6a\u300d\u3001\u300c\u5b9a\u7f6a\u300d\uff1aSNG02919\uff0c\u300c\u5ba3\u5224\u300d\u3001\u300c\u88c1\u51b3\u300d\u3001\u300c\u4ea4\r\n                                      \u4ed8\u5224\u7f6a\u300d\u3002\r\n            \u25ce\u8fd9\u91cc\u63d0\u5230\u4e0a\u5e1d\u5dee\u6d3e\u8036\u7a23\u5230\u4e16\u4e0a\u7684\u4e3b\u8981\u76ee\u7684\u5e76\u975e\u662f\u8981\u5b9a\u7f6a\uff0c\u800c\u662f\u8981\u62ef\r\n              \u6551\u3002\u4f46\u662f\u540e\u9762\u7acb\u523b\u63d0\u5230\u8036\u7a23\u6765\u6240\u5e26\u6765\u7684\u9644\u5e26\u5ba1\u5224\u4f5c\u7528\u3002\r\n\r\n          9.\u4f46\u662f\u771f\u7406\u7684\u51fa\u73b0\u4e5f\u5e26\u6765\u5fc5\u7136\u7684\u5ba1\u5224\uff0c\u56e0\u4e3a\u4eba\u5bf9\u771f\u7406\u7684\u4e0d\u63a5\u53d7\u5c31\u663e\u51fa\u81ea\r\n            \u5df1\u4e0d\u559c\u7231\u771f\u7406\uff0c\u5e94\u8be5\u53d7\u5ba1\u5224\u3002 #3:18-21|\r\n            \u25cf\u300c\u5b9a....\u7f6a\u300d\uff1aSNG02920\uff0c\u300c\u5ba1\u5224\u300d\u3001\u300c\u5224\u65ad\u300d\u3002\r\n            \u25cf\u300c\u4fe1\u300d\u3001\u300c\u4e0d\u4fe1\u300d\uff1a\u539f\u6587\u7684\u65f6\u6001\u90fd\u663e\u793a\u8fd9\u662f\u6307\u6301\u7eed\u7684\u4fe1\u6216\u4e0d\u4fe1\uff0c\u800c\r\n                                \u975e\u6307\u6682\u65f6\u7684\u72b6\u6001\u3002\r\n            \u25ce\u771f\u7406\u51fa\u73b0\uff0c\u81ea\u7136\u5c31\u5e26\u6765\u300c\u533a\u522b\u300d\u3002\u56e0\u7740\u6bcf\u4e2a\u4eba\u5bf9\u771f\u7406\u7684\u4e0d\u540c\u53cd\u5e94\uff0c\r\n              \u5c31\u663e\u51fa\u6bcf\u4e2a\u4eba\u5230\u5e95\u662f\u4e0d\u662f\u5c5e\u4e8e\u771f\u7406\u7684\uff0c\u662f\u4e0d\u662f\u771f\u5fc3\u7231\u771f\u7406\u7684\u3002\u56e0\u6b64\r\n              \u771f\u7406\u6765\u7684\u4e3b\u8981\u76ee\u7684\u867d\u7136\u4e0d\u662f\u5b9a\u7f6a\uff0c\u5374\u4e5f\u5fc5\u7136\u5e26\u6765\u300c\u5206\u522b\u300d\u7684\u4f5c\u7528\u3002"}]}