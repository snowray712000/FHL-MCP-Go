"text":" -\u5152\u5973\u5c0d\u7236\u6bcd\u7684\u611b\r\n   .\u898b[!\u5152\u5973\/\u5c0f\u5b69\u5b50!]\r\n\r\n -\u4e0a\u5e1d\u7684\u611b\r\n   .\u898b <a href=\"t.php?k=0002043&N=1\">\u4e0a\u5e1d<\/a>, \u4e0a\u5e1d\u7684\u611b\r\n\r\n -\u4eba\u5c0d\u4e0a\u5e1d\u7684\u611b\r\n    #\u51fa 20:6; \u7533 5:10; 6:5; 7:9; 10:12; 11:1,13,22; 13:3|\r\n    #\u7533 30:6,16,20; \u66f8 22:5; 23:11; \u8a69 18:1; 31:23; 37:4; 45:10,11|\r\n    #\u8a69 63:5,6; 69:35,36; 73:25,26; 91:14; 97:10; 116:1; 145:20|\r\n    #\u7bb4 8:17; 23:26; \u8cfd 56:6,7; \u8036 2:2,3; \u592a 22:37,38|\r\n    #\u592a 12:29,30,32,33; \u8def 11:42; \u7d04 5:42; \u7f85 5:5; 8:28; \u6797\u524d 8:3|\r\n    #\u8153 1:9; \u5e16\u5f8c 3:5; \u63d0\u5f8c 1:7; \u7d04\u4e00 2:5,15; 3:17,18; 4:12,16-21|\r\n    #\u7d04\u4e00 5:1-3; \u7d04\u4e8c 1:6; \u7336 1:21|\r\n\r\n -\u4eba\u5c0d\u8036\u7a4c\u7684\u611b\r\n    #\u592a 10:37,38; 25:34-40; 27:55-61; \u53ef 9:41; \u8def 2:29,30; 7:47|\r\n    #\u7d04 8:42; 14:15,21,23,28; 15:9; 16:27; 17:26; 21:17|\r\n    #\u5f92 21:13; \u6797\u524d 16:22; \u6797\u5f8c 5:6,8,14,15; \u52a0 5:6,22; 6:14|\r\n    #\u5f17 3:17-19; 4:15; 6:24; \u8153 1:9,20,21,23; 3:7,8; \u897f 1:8|\r\n    #\u5e16\u5f8c 3:5; \u63d0\u5f8c 1:13; 4:8; \u9580 1:5; \u4f86 6:10; \u96c5 1:12; 2:5|\r\n    #\u5f7c\u524d 1:8; 2:7; \u555f 2:4|\r\n\r\n -\u611b\u8036\u7a4c\u7684\u4f8b\u5b50\r\n   .\u99ac\u5229\u4e9e\r\n      #\u592a 26:6-13; \u7d04 12:3-8; \u8def 10:39|\r\n   .\u5f7c\u5f97\r\n      #\u592a 17:4; \u7d04 13:37; 18:10; 20:3-6; 21:7|\r\n   .\u591a\u99ac\r\n      #\u7d04 11:16|\r\n   .\u9580\u5f92\r\n      #\u53ef 16:10; \u8def 24:17-41; \u7d04 20:20|\r\n   .\u62b9\u5927\u62c9\u7684\u99ac\u5229\u4e9e\u548c\u5176\u4ed6\u9580\u5f92\r\n      #\u592a 27:55,56,61; 28:1-9; \u8def 8:2,3; 23:27,55,56; 24:1-10|\r\n      #\u7d04 20:1,2,11-18|\r\n   .\u683c\u5927\u62c9 (\u683c\u62c9\u68ee) \u4eba, \u8036\u7a4c\u66fe\u70ba\u4ed6\u8d95\u9b3c\r\n      #\u53ef 5:18|\r\n   .\u4e9e\u5229\u99ac\u592a\u7684\u7d04\u745f\r\n    