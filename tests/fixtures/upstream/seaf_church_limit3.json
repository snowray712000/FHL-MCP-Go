"orig":"0",
"key":"\u6559\u6703",
"record_count":3,
"record":[{"id":0,"chineses":"\u5e15\u76ae\u4e9e\u6b98\u7bc7","bid":216,"engs":"Frag. Papias","chap":0,"sec":0,"bible_text":"\u5e15\u76ae\u4e9e\u662f\u897f\u5143\u4e8c\u4e16\u7d00\u4e0a\u534a\u8449\uff0c\u5c0f\u4e9e\u7d30\u4e9e\u5f17\u5442\u5bb6\u7701\u5e0c\u62c9\u6ce2\u7acb\u57ce\uff08Hierapolis\uff09\u7684\u4e3b\u6559\uff0c\u548c\u5761\u65c5\u7532\u4e00\u6a23\uff0c\u50b3\u7d71\u8a8d\u70ba\u4ed6\u662f\u4f7f\u5f92\u7d04\u7ff0\u7684\u9580\u5f92\uff08\u611b\u4efb\u7d10\uff1a\u300a\u99c1\u7570\u7aef\u300b5.33.4\uff09\uff0c\u6211\u5011\u73fe\u5728\u6c92\u6709\u9019\u4f4d\u4e3b\u6559\u8457\u4f5c\u7684\u4efb\u4f55\u6284\u672c\uff0c\u53ea\u80fd\u5f9e\u5f8c\u4f86\u6559\u7236\u8457\u4f5c\u7684\u7d22\u5f15\u4e2d\uff0c\u6536\u96c6\u5230\u4ed6\u7684\u8457\u4f5c\u7684\u7247\u6bb5\u3002 \u5c0d\u65bc\u9019\u4f4d\u6559\u7236\u6642\u671f\u986f\u8d6b\u7684\u9818\u8896\uff0c\u6211\u5011\u6240\u77e5\u4e0d\u591a\uff0c\u751a\u81f3\u4ed6\u51fa\u751f\u6216\u6b7b\u53bb\u7684\u5e74\u4efd\u4e5f\u4e0d\u6e05\u695a\uff0c\u4ed6\u53ef\u80fd\u662f\u5761\u65c5\u7532\u540c\u6642\u671f\u7684\u4eba\uff08\u611b\u4efb\u7d10\uff1a\u300a\u99c1\u7570\u7aef\u300b5.33.4\uff09\uff0c\u5373\u897f\u514370\u81f3160\u5e74\u4e4b\u9593\u3002<br\/><br\/>\u512a\u897f\u6bd4\u70cf\u8d77\u521d\u4f3c\u4e4e\u63a5\u53d7\u5e15\u6c0f\u662f\u4f7f\u5f92\u7684\u9580\u751f\u53ca\u898b\u8b49\u4eba\uff0c\u4f46\u5f8c\u4f86\u537b\u8cea\u7591\u9019\u4e00\u8aaa\u6cd5\uff08\u300a\u6559\u6703\u6b77\u53f2\u300b3.39.2\uff09\u3002 \u512a\u6c0f\u5c0d\u5e15\u76ae\u4e9e\u8207\u4f7f\u5f92\u7d04\u7ff0\u4e4b\u9593\u5e2b\u5f92\u95dc\u4fc2\u7684\u8cea\u7591\uff0c\u662f\u56e0\u70ba\u5728\u5e15\u76ae\u4e9e\u8457\u4f5c\u7684\u524d\u8a00\u4e2d\uff0c\u5e15\u76ae\u4e9e\u63d0\u5230\u6709\u5169\u4f4d\u7d04\u7ff0\uff0c\u4e00\u4f4d\u662f\u4f7f\u5f92\u7d04\u7ff0\uff0c\u53e6\u4e00\u4f4d\u662f\u9577\u8001\u7d04\u7ff0\uff0c\u5e15\u76ae\u4e9e\u4f3c\u4e4e\u662f\u8207\u9577\u8001\u7d04\u7ff0\u4ee5\u53ca\u4e00\u4f4d\u540d\u53eb\u96c5\u91cc\u65af\u63d0\u905c\uff08Aristion\uff09\u7684\u4eba\u6709\u95dc\uff08\u300a\u6559\u6703\u6b77\u53f2\u300b3.39.3-7\uff09\u3002 \u4f46\u4e0d\u80fd\u78ba\u5b9a\u512a\u6c0f\u662f\u5426\u56e0\u70ba\u5e15\u76ae\u4e9e\u53ea\u662f\u9577\u8001\u7d04\u7ff0\u7684\u9580\u751f\uff0c\u5176\u6b0a\u5a01\u6709\u9650\uff0c\u56e0\u800c\u8a9e\u5e36\u8cb6\u6291\uff0c\u9084\u662f\u56e0\u70ba\u512a\u6c0f\u4e0d\u8d0a\u6210\u5e15\u6c0f\u7684\u5343\u5e74\u570b\u5ea6\u7684\u8aaa\u6cd5\uff08chiliasm\uff09\uff0c\u751a\u800c\u8a8d\u70ba\u6301\u9019\u4fe1\u5ff5\u7684\u5e15\u76ae\u4e9e\uff0c\u662f\u4e00\u4f4d\u667a\u529b\u4f4e\u4e0b\u7684\u4eba\uff08\u300a\u6559\u6703\u6b77\u53f2\u300b3.39.13\uff09\u3002 \u6309\u6b64\u89e3\u91cb\uff0c\u512a\u6c0f\u8a8d\u70ba\u300a\u555f\u793a\u9304\u300b\u662f\u9577\u8001\u7d04\u7ff0\u6240\u5beb\uff0c\u5e15\u76ae\u4e9e\u548c\u9019\u4f4d\u9577\u8001\u5c6c\u65bc\u540c\u4e00\u9663\u71df\u3002 \u9019\u9577\u8001\u7d04\u7ff0\u662f\u4e3b\u7684\u9580\u5f92\u4e4b\u4e00\uff0c\u4f46\u4ed6\u4e0d\u53ef\u80fd\u8207\u4f7f\u5f92\u7d04\u7ff0\u662f\u540c\u4e00\u4eba\uff0c\u6975\u53ef\u80fd\u9019\u4f4d\u7a31\u70ba\u9577\u8001\u7684\u7d04\u7ff0\u548c\u96c5\u91cc\u65af\u63d0\u905c\uff0c\u540c\u662f\u8036\u7a4c\u7684\u9580\u5f92\uff0c\u7a31\u9019\u7d04\u7ff0\u70ba\u9577\u8001\uff0c\u662f\u8981\u5c07\u4ed6\u8207\u5341\u4e8c\u9580\u5f92\u4e4b\u4e00\u7684\u7d04\u7ff0\u5206\u5225\u958b\u4f86\u3002<br\/><br\/>\u6839\u64da\u512a\u897f\u6bd4\u70cf\uff08\u300a\u6559\u6703\u6b77\u53f2\u300b3.39.15\uff09\u7684\u6558\u8ff0\uff0c\u5e15\u76ae\u4e9e\u5f9e\u201c\u9577\u8001\u201d\u8655\u5f97\u6089\u99ac\u53ef\u662f\u5f7c\u5f97\u7684\u8a6e\u91cb\u8005\uff08\u1f11\u03c1\u03bc\u03b7\u03bd\u03b5\u03c5\u03c4\u03ae\u03c2\uff09\uff0c\u99ac\u53ef\u4e26\u975e\u8036\u7a4c\u7684\u89aa\u773c\u898b\u8b49\u4eba\uff0c\u4ed6\u5beb\u300a\u99ac\u53ef\u798f\u97f3\u300b\u6642\uff0c\u6c92\u6709\u6309\u7167\u8036\u7a4c\u8a00\u884c\u7684\u771f\u5be6\u6b21\u5e8f\uff0c\u53ea\u662f\u5c07\u8a18\u61b6\u4e2d\u5f7c\u5f97\u6240\u6559\u5c0e\u7684\u8036\u7a4c\u7684\u8a00\u884c\u4e8b\u8e5f\u5beb\u4e0b\u4f86;\u53e6\u5916\u99ac\u592a\u6536\u96c6\u4e86\u8036\u7a4c\u5e0c\u4f2f\u4f86\u8a9e\uff08\u4e9e\u862d\u8a9e\uff1f \uff09\u7684\u6559\u8a13\uff0c\u4e26\u76e1\u5176\u6240\u80fd\u5c07\u4e4b\u89e3\u91cb\uff08\u1f11\u03c1\u03bc\u03b7\u03bd\u03b5\u1fe6\u03c3\u03b5\u03bd\uff09\u51fa\u4f86\uff08\u300a\u6559\u6703\u6b77\u53f2\u300b3.39.16;\u53c32.15\uff09\uff0c\u9019\u53ef\u80fd\u662f\u6307\u5c07\u5b83\u7ffb\u8b6f\u6210\u5e0c\u81d8\u6587\u3002 \u6b64\u5916\u9084\u6709\u53e6\u4e00\u672c\u798f\u97f3\u66f8\uff0c\u53eb\u300a\u5e0c\u4f2f\u4f86\u4eba\u798f\u97f3\u66f8\u300b\uff08\u300a\u6559\u6703\u6b77\u53f2\u300b3.39.17\uff09\u3002 \u4e26\u6c92\u6709\u78ba\u5207\u7684\u8b49\u64da\u8868\u660e\u5e15\u76ae\u4e9e\u77e5\u9053\u300a\u8def\u52a0\u798f\u97f3\u300b\u548c\u300a\u7d04\u7ff0\u798f\u97f3\u300b\u7684\u5b58\u5728\u3002 \u512a\u897f\u6bd4\u70cf\u66fe\u8aaa\u5e15\u76ae\u4e9e\u4f7f\u7528\u4e86\u300a\u7d04\u7ff0\u4e00\u66f8\u300b\u548c\u5f7c\u5f97\u66f8\u4fe1\u7684\u898b\u8b49\uff0c\u7136\u800c\u5c31\u6211\u5011\u5df2\u6709\u7684\u8cc7\u6599\uff0c\u4ed6\u7684\u8457\u4f5c\u4e26\u6c92\u6709\u53d7\u7d04\u7ff0\u548c\u5f7c\u5f97\u7684\u66f8\u4fe1\u6240\u5f71\u97ff\uff0c\u4f46\u5e15\u76ae\u4e9e\u5c0d\u7336\u592a\u57fa\u7763\u6559\u7684\u8208\u8da3\uff0c\u53ef\u898b\u65bc\u4ed6\u5c0d\u5f7c\u5f97\u7684\u50b3\u7d71\u7684\u8208\u8da3\uff0c\u5305\u62ec\u300a\u99ac\u53ef\u798f\u97f3\u300b\u548c\u300a\u5f7c\u5f97\u524d\u66f8\u300b\uff0c\u4ee5\u53ca\u300a\u99ac\u592a\u798f\u97f3\u300b\u4f86\u81ea\u5e0c\u4f2f\u4f86\u8a9e\uff08\u4e9e\u862d\u8a9e\uff1f\uff09\u7684\u8a9e\u9304\u3002 \u8036\u67d4\u7c73\u5c31\u66fe\u6307\u51fa\u300c\u5343\u5e74\u570b\u5ea6\u300d\u7684\u770b\u6cd5\u662f\u51fa\u65bc\u7336\u592a\u50b3\u7d71\u7684\u3002 <br\/><br\/>\u6839\u64da\u611b\u4efb\u7d10\uff08\u300a\u99c1\u7570\u7aef\u300b5.33.4\uff09\u7684\u6558\u8ff0\uff0c\u5e15\u76ae\u4e9e\u66fe\u8457\u6709\u4e00\u90e8\u540d\u70ba\u300a\u4e3b\u7684\u8a9e\u9304\u91cb\u7fa9\u300b\uff08\u201cExposition of the Lord's Logia\u201d\uff0c\u898b\u512a\u897f\u6bd4\u70cf\uff1a\u300a\u6559\u6703\u6b77\u53f2\u300b3.39.1\uff09\u7684\u66f8\uff0c\u5171\u4e94\u518a\u3002 \u6240\u8b02\u300c\u8a9e\u9304\u300d\u6cdb\u6307\u8036\u7a4c\u7684\u8a00\u884c\uff0c\u6240\u8b02\u300c\u91cb\u7fa9\u300d\uff08exegesis\uff09\u53ef\u80fd\u662f\u6307\u5c07\u9019\u4e9b\u8a00\u8a5e\u6536\u96c6\u53ca\u6392\u5217\u8d77\u4f86\u3002 \u5c0d\u6bd4\u5df2\u5beb\u4e0b\u4f86\u7684\u8457\u4f5c\uff0c\u5927\u6982\u6307\u798f\u97f3\u66f8\uff0c\u5e15\u76ae\u4e9e\u6307\u90a3\u4e9b\u201c\u6d3b\u7684\u9577\u5b58\u7684\u8072\u97f3\u201d\uff08\u201cliving and abiding voice\u201d\uff09\uff0c\u5373\u4f7f\u5f92\u6216\u4ed6\u5011\u7684\u9580\u5f92\u53e3\u50b3\u7684\u50b3\u7d71\uff0c\u4ed6\u8a8d\u70ba\u53e3\u50b3\u7684\u6559\u5c0e\uff0c\u6bd4\u5beb\u4e0b\u4f86\u7684\u8457\u4f5c\u66f4\u52dd\u4e00\u7c4c\uff08\u300a\u6559\u6703\u6b77\u53f2\u300b3.39.3-4\uff09\u3002 <br\/><br\/>\u5e15\u76ae\u4e9e\u5c0d\u53e3\u8ff0\u50b3\u7d71\u7684\u6ce8\u91cd\uff0c\u53ef\u898b\u65bc\u4ee5\u4e0b\u7684\u4f8b\u5b50\uff0c\u4ed6\u66fe\u5f15\u7528\u4e00\u4efd\u6c92\u6709\u8036\u7a4c\u8a00\u8ad6\u7684\u53e3\u8ff0\u8cc7\u6599\uff0c\u5c31\u662f\u5728\u6b7b\u4eba\u5fa9\u6d3b\u5f8c\uff0c\u57fa\u7763\u570b\u5ea6\u5728\u5730\u4e0a\u5efa\u7acb\u4e00\u5343\u5e74\uff08\u300a\u6559\u6703\u6b77\u53f2\u300b3.39.11-12;\u53c3\u555f\u5eff1-6\uff09\uff0c\u5728\u90a3\u4e9b\u65e5\u5b50\uff0c\u96e3\u4ee5\u60f3\u50cf\u5728\u5730\u4e0a\u6709\u90a3\u9ebc\u591a\u8461\u8404\u548c\u9ea5\u5b50\u7684\u6536\u6210\uff08\u611b\u4efb\u7d10\uff1a\u300a\u99c1\u7570\u7aef\u300b5.33.3-4\uff09\uff0c\u4ed6\u5047\u8a2d\u9019\u50b3\u7d71\u662f\u51fa\u81ea\u8036\u7a4c\uff0c\u5f9e\u7d04\u7ff0\u548c\u9577\u8001\u5011\u800c\u4f86\u3002 \u5e15\u76ae\u4e9e\u4f3c\u4e4e\u5c0d\u672b\u4e16\u76fc\u671b\uff0c\u5343\u79a7\u5e74\u570b\u5ea6\u7684\u554f\u984c\uff0c\u751a\u611f\u8208\u8da3\u3002 \u4ed6\u5c0d\u5343\u5e74\u570b\u5ea6\u7684\u89c0\u9ede\uff0c\u5f8c\u4f86\u70ba\u611b\u4efb\u7d10\u548c\u4e9e\u6ce2\u91cc\u62ff\u7559\u6240\u652f\u63f4\uff08Apollinaris of Laodicaeo\uff0c\u897f\u5143\u7b2c4\u4e16\u7d00\uff09\u3002<br\/><br\/>\u5e15\u76ae\u4e9e\u4ea6\u4fdd\u7559\u4e86\u4e00\u4e9b\u4f7f\u5f92\u884c\u795e\u8e5f\u7684\u6545\u4e8b\uff0c\u5982\u5e0c\u62c9\u6ce2\u7acb\u57ce\u5c45\u4f4f\u7684\u8153\u529b\u7684\u5973\u5152\u5011\u6240\u884c\u7684\u795e\u8e5f\uff08\u53c3\u5f9221\uff1a8\uff09\uff0c\u4ee5\u53ca\u5df4\u6492\u5df4\u7336\u58eb\u90fd\u548c\u99ac\u63d0\u4e9e\uff08\u5f921\uff1a23\uff09\u6240\u884c\u7684\u795e\u8e5f\uff08\u300a\u6559 \u6703\u6b77\u53f2\u300b3.39.8-10\uff09;\u9084\u6709\u8a18\u8f09\u65bc\u300a\u5e0c\u4f2f\u4f86\u4eba\u798f\u97f3\u66f8\u300b\uff0c\u6709\u95dc\u4e00\u540d\u72af\u4e86\u8a31\u591a\u7f6a\u7684\u5a66\u4eba\u4f86\u5230\u4e3b\u7684\u9762\u524d\u7684\u4e8b\u8e5f\uff08\u300a\u6559\u6703\u6b77\u53f2\u300b3.39.17;\u53c3\u7d04\u4e0353-\u516b11\uff09\u3002 \u6839\u64da\u8001\u5e95\u5609\u7684\u4e9e\u6ce2\u91cc\u62ff\u7559\u7684\u8a18\u8f09\uff0c\u5e15\u76ae\u4e9e\u5728\u300a\u4e3b\u7684\u8a9e\u9304\u91cb\u7fa9\u300b\u7684\u7b2c\u56db\u518a\u4e2d\uff0c\u8a18\u8f09\u4e86\u51fa\u8ce3\u8036\u7a4c\u7684\u7336\u5927\u60b2\u6158\u7684\u4e0b\u5834\u3002 \u300a\u4e9e\u6b77\u5c71\u5927\u6284\u672c\u300b\uff08\u897f\u51439\u4e16\u7d00\uff09\u8072\u7a31\u7d04\u7ff0\u798f\u97f3\u66f8\u662f\u4f7f\u5f92\u7d04\u7ff0\u7684\u9580\u5f92\u5e15\u76ae\u4e9e\uff0c\u5c07\u7d04\u7ff0\u6240\u8aaa\u7684\u539f\u539f\u672c\u672c\u5730\u9ed8\u5beb\u4e0b\u4f86\u7684\uff0c\u7136\u800c\u9019\u50b3\u7d71\u7684\u53ef\u9760\u6027\uff0c\u5747\u88ab\u8cea\u7591\u3002<br\/><br\/><h2>\u88dc\u5145\u53c3\u8003\uff1a<\/h2><br\/>W. R. Schoedel\uff0c Polycarp\uff0c Martyrdom of Polycarp\uff0c Fragments of Papias.The Apostolic Fathers\u7b2c5\u5377\uff0cR. M. Grant\uff081967\uff09\u7de8\u8f2f;\u540c\u4e0a\u4f5c\u8005ABD 5\uff1a140-42\u3002"},
{"id":0,"chineses":"\u9ed1\u99ac\u7267\u4eba\u66f8","bid":214,"engs":"Herm.","chap":0,"sec":0,"bible_text":"\u300a\u9ed1\u99ac\u7267\u4eba\u66f8\u300b\u662f\u4f7f\u5f92\u6559\u7236\u8457\u4f5c\u4e2d\u6700\u9577\u7684\u4e00\u5377\uff0c\u5168\u66f8\u7531\u4e09\u90e8\u5206\u7d44\u6210\uff0c\u4f9d\u6b21\u70ba\u3008\u7570\u8c61\u7bc7\u3009\u3001\u3008\u547d\u4ee4\u7bc7\u3009\u548c\u3008\u6bd4\u55bb\u7bc7\u3009\u3002 \u201c\u9ed1\u99ac\u201d\u4e26\u975e\u7267\u4eba\uff0c\u9019\u66f8\u540d\u7684\u610f\u601d\u61c9\u662f\u201c\u9ed1\u99ac\u7684\u7267\u4eba\u201d\uff0c\u9ed1\u99ac\u548c\u7267\u4eba\u662f\u5169\u500b\u4e0d\u540c\u7684\u4eba\u7269\u3002 \u5f9e\u3008\u7570\u8c61\u7bc7\u3009\u7b2c\u4e94\u5377\u958b\u59cb\uff0c\u4e00\u4f4d\u5929\u4f7f\u4ee5\u7267\u4eba\u7684\u5f62\u8c61\u51fa\u73fe\uff0c\u6307\u5c0e\u9ed1\u99ac\u95dc\u65bc\u4ed6\u6240\u898b\u5230\u7684\u7570\u8c61\u7684\u610f\u7fa9\uff0c\u9ed1\u99ac\u8981\u5c07\u9019\u4e9b\u6559\u5c0e\u50b3\u905e\u7d66\u6559\u6703\uff0c\u5dee\u4e0d\u591a\u6574\u672c\u3008\u547d\u4ee4\u7bc7\u3009\u53ca\u5927\u90e8\u5206\u7684\u3008\u6bd4\u55bb\u7bc7\u3009\uff0c\u90fd\u662f\u7267\u4eba\u5411\u9ed1\u99ac\u6240\u50b3\u905e\u7684\u6559\u5c0e\u3002 \u9019\u7267\u4eba\u88ab\u7a31\u70ba\u300c\u6094\u6539\u7684\u5929\u4f7f\u300d\uff08\u3008\u7570\u8c61\u7bc7\u30095.7[25\uff1a7]; \u3008\u547d\u4ee4\u7bc7\u300912.6.1[49\uff1a1]\uff09\uff0c\u5176\u516c\u8077\u662f\u76e3\u7ba1\u6574\u500b\u4eba\u6094\u6539\u7684\u904e\u7a0b\u3002 \u6700\u5f8c\u4ed6\u88ab\u59d4\u6d3e\u4f5c\u70ba\u9ed1\u99ac\u5bb6\u5ead\u7684\u5b88\u8b77\u5929\u4f7f\uff08\u3008\u6bd4\u55bb\u7bc7\u300910.24.4[114\uff1a4]\uff09\u3002<br\/><br\/>\u672c\u66f8\u5728\u897f\u5143\u7b2c\u4e8c\u81f3\u7b2c\u4e09\u4e16\u7d00\u57fa\u7763\u6559\u5708\u5b50\u4e2d\uff0c\u5099\u53d7\u6b61\u8fce\u3002 \u4e9e\u6b77\u5c71\u5927\u7684\u9769\u5229\u514d\u662f\u9996\u4f4d\u63d0\u53ca\u6b64\u66f8\u7684\u4eba\uff0c\u4e26\u4e14\u66fe\u591a\u6b21\u5f15\u7528\u6b64\u66f8\uff0c\u5c07\u4e4b\u770b\u70ba\u662f\u57fa\u65bc\u555f\u793a\u800c\u4f86\u7684\u7d93\u66f8\uff0c\u8207\u4fdd\u7f85\u66f8\u4fe1\u5e73\u7b49\u4e26\u5217\u3002 \u9769\u5229\u514d\u7684\u5b78\u751f\u4fc4\u5229\u6839\uff08\u7d04\u897f\u5143185-254\uff09\u96d6\u5c0d\u6b64\u66f8\u7684\u6b0a\u5a01\u8f03\u6709\u4fdd\u7559\uff0c\u4e5f\u66fe\u4e09\u6b21\u5f15\u7528\u6b64\u66f8\uff08\u300a\u6e90\u8d77\u300b1.3.3\uff0c4.1.1-12\u53ca\u300a\u7d04\u7ff0\u798f\u97f3\u8a3b\u91cb\u300b\uff09\uff0c\u8996\u4e4b\u70ba\u5177\u6b0a\u5a01\u7684\u7d93\u66f8\u3002 \u6839\u64da\u512a\u897f\u6bd4\u70cf\u7684\u8a18\u8f09\uff08\u300a\u6559\u6703\u6b77\u53f2\u300b5.8.7\uff09\uff0c\u91cc\u6602\u4e3b\u6559\u611b\u4efb\u7d10\uff08\u7d04\u897f\u5143140-200\u5e74\uff09\u4e5f\u8996\u300a\u9ed1\u99ac\u7267\u4eba\u66f8\u300b\u70ba\u7d93\u66f8\uff0c\u4f46\u4ed6\u4f3c\u4e4e\u5f9e\u4f86\u6c92\u6709\u5f15\u7528\u904e\u9019\u66f8\u3002 \u7b2c\u4e09\u4e16\u7d00\u5e0c\u81d8\u7684\u795e\u5b78\u5bb6\u591a\u63a5\u53d7\u5b83\u70ba\u6b63\u5178\u3002 \u897f\u5948\u6284\u672c\uff08\u897f\u5143\u56db\u4e16\u7d00\uff09\u5247\u5c07\u300a\u5df4\u62ff\u5df4\u66f8\u4fe1\u300b\u548c\u300a\u9ed1\u99ac\u7267\u4eba\u66f8\u300b\u5217\u70ba\u65b0\u7d04\u7684\u6700\u5f8c\u5169\u5377\uff0c\u7136\u800c\u6709\u5b78\u8005\u8a8d\u70ba\u897f\u5948\u6284\u672c\u53ea\u662f\u5c07\u6b64\u5169\u5377\u66f8\u770b\u70ba\u9644\u9801\uff0c\u4e26\u975e\u7d93\u76ee\u7684\u4e00\u90e8\u5206\u3002 \u6b64\u5916\u7b2c\u516d\u4e16\u7d00\u7684\u300a\u6e05\u5c71\u6284\u672c\u300b\uff08Codex Claromontanus\uff09\u4e5f\u5c07\u6b64\u66f8\u8207\u300a\u5df4\u62ff\u5df4\u66f8\u4fe1\u300b\u3001\u300a\u4fdd\u7f85\u884c\u50b3\u300b\u3001\u300a\u5f7c\u5f97\u555f\u793a\u9304\u300b\u4e00\u540c\u7d0d\u5165\u65b0\u7d04\u7d93\u76ee\u4e4b\u4e2d\u3002 \u60df\u5728\u7b2c\u56db\u4e16\u7d00\u6642\uff0c\u512a\u897f\u6bd4\u70cf\u662f\u7b2c\u4e00\u4f4d\u4e3b\u8981\u7684\u5b78\u8005\uff08\u300a\u6559\u6703\u6b77\u53f2\u300b3.3\uff09\uff0c\u4e0d\u5c07\u5b83\u653e\u5728\u6b63\u5178\u7d93\u76ee\u4e4b\u5217\uff0c\u512a\u6c0f\u8a8d\u70ba\u6709\u4e00\u4e9b\u6b0a\u5a01\uff08\u6c92\u6709\u8aaa\u660e\u662f\u54ea\u4e9b\uff09\u4e0d\u63a5\u53d7\u6b64\u66f8\u70ba\u6b63\u5178\uff0c\u4f46\u4ed6\u4ecd\u8996\u4e4b\u70ba\u4e00\u672c\u5728\u6559\u5c0e\u4e0a\u5f88\u6709\u8aac\u660e\u7684\u66f8\u3002 \u300a\u7a46\u62c9\u591a\u5229\u6b63\u5178\u300b\uff08Muratorian Canon\uff09\u5c07\u6b64\u66f8\u6392\u9664\u5728\u6b63\u5178\u4e4b\u5916\uff0c\u56e0\u70ba\u5b83\u7f3a\u4e4f\u4f7f\u5f92\u6027\uff08apostolicity\uff09\uff0c\u975e\u4f86\u81ea\u4f7f\u5f92\u7684\u7d71\u7dd2\uff0c\u540c\u6642\u8a8d\u70ba\u6b64\u66f8\u662f\u8f03\u5f8c\u671f\u5beb\u6210\uff0c\u96d6\u7136\u5982\u6b64\uff0c\u300a\u7a46\u62c9\u591a\u5229\u6b63\u5178\u300b\u7684\u4f5c\u8005\u4ecd\u8a8d\u70ba\u6b64\u66f8\u6709\u95b1\u8b80\u7684\u50f9\u503c\uff0c\u4f46\u4e0d\u503c\u5f97\u516c\u958b\u5728\u6559\u6703\u7684\u656c\u62dc\u4e2d\u8aa6\u8b80\u3002 \u7279\u571f\u826f\u96d6\u66fe\u4e00\u5ea6\u63a5\u53d7\u9019\u66f8\u70ba\u7d93\u66f8\uff0c\u4f46\u5728\u52a0\u5165\u4e86\u5b5f\u4ed6\u52aa\u6d3e\u7cfb\u4e4b\u5f8c\uff0c\u8a8d\u70ba\u9019\u66f8\u5c0d\u6094\u6539\u7684\u770b\u6cd5\u904e\u65bc\u5bec\u9b06\uff0c\u7a31\u9019\u66f8\u70ba\u201c\u72af\u8005\u7684\u7267\u4eba\u201d\u3002 <br\/><br\/>\u6b64\u66f8\u898b\u65bc\u4e09\u4efd\u5e0c\u81d8\u6284\u672c\uff1a\u897f\u5948\u6284\u672c\uff0c\u53ea\u7531\u3008\u7570\u8c61\u7bc7\u30091.1.1[1\uff1a1]\u81f3\u3008\u547d\u4ee4\u7bc7\u30094.3.6[31\uff1a6]; \u300a\u96c5\u5bcc\u58eb\u6284\u672c\u300b\uff08Codex Athous\uff0c\u897f\u5143\u5341\u56db-\u4e94\u4e16\u7d00\uff0c\u4ee5\u3008\u6bd4\u55bb\u7bc7\u30099.30.2[107\uff1a2]\u4f5c\u7d50\uff09; \u548c\u300a\u5bc6\u897f\u6839\u84b2\u8349\u5377\u300b129\uff08Michigan Papyrus; \u897f\u5143\u4e09\u4e16\u7d00\uff09\uff0c\u6709\u3008\u6bd4\u55bb\u7bc7\u30092.8-9.5.1[51\uff1a1-82\uff1a1]\u3002 \u6b64\u5916\u9084\u6709\u4e00\u4e9b\u5e0c\u81d8\u7684\u6b98\u7bc7\u3001\u5169\u4efd\u5b8c\u6574\u7684\u62c9\u4e01\u7248\u672c\uff08\u300a\u6b66\u52a0\u5927\u8b6f\u672c\u300b\u548c\u300a\u5df4\u5217\u4e01\u7248\u672c\u300b\uff09\u3001\u4e00\u4efd\u8863\u7d22\u6bd4\u4e9e\u7248\u672c\uff08\u897f\u5143\u56db\u4e16\u7d00\uff09\u3001\u53ca\u5c11\u91cf\u79d1\u666e\u66ff\u548c\u4e2d\u6ce2\u65af\u7248\u672c\u3002 \u9019\u8868\u793a\u3008\u6bd4\u55bb\u7bc7\u30099.30.3\u81f310.4.5[107\uff1a3-114\uff1a5]\u4e3b\u8981\u4f9d\u8cf4\u62c9\u4e01\u7248\u672c\u3002 <br\/><br\/>\u672c\u66f8\u6709\u5169\u7a2e\u5206\u7ae0\u7bc0\u7684\u65b9\u6cd5\uff0c\u820a\u7684\u65b9\u5f0f\u5206\u6bb5\u4ee5\u3008\u7570\u8c61\u7bc7\u3009\u3001\u3008\u547d\u4ee4\u7bc7\u3009\u548c\u3008\u6bd4\u55bb\u7bc7\u3009\u4f5c\u5927\u984c\uff0c\u7136\u5f8c\u5206\u7ae0\u7bc0\uff0c\u65b0\u7684\u65b9\u5f0f\u5247\u53ea\u6709\u7ae0\u7bc0\u3002<br\/><br\/><h2>\u4f5c\u8005<\/h2><br\/>\u6839\u64da\u9ed1\u99ac\u7267\u4eba\u66f8\u4f5c\u8005\u7684\u81ea\u8ff0\uff0c\u4ed6\u539f\u662f\u7f85\u99ac\u4e00\u4f4d\u7a31\u70ba\u7f85\u5927\uff08Rhoda\uff09\u5973\u58eb\u7684\u5974\u96b8\uff08\u3008\u7570\u8c61\u7bc7\u30091.1.1-2\uff3b1:1\uff0d2\uff3d\uff09\u3002 \u5927\u6982\u5f8c\u4f86\u7f85\u5927\u9084\u4e86\u9ed1\u99ac\u7684\u81ea\u7531\u8eab\uff0c\u81ea\u6b64\u4ed6\u4fbf\u7d93\u71df\u67d0\u7a2e\u4e8b\u696d\uff0c\u4f46\u537b\u672a\u6709\u8aaa\u660e\u662f\u4ec0\u9ebc\uff0c\u53ef\u80fd\u662f\u5de5\u5320\u3001\u8ce3\u9152\u5546\u4eba\uff08Jeffers\uff09\u6216\u662f\u52d9\u8fb2\uff08J. C. Wilson\uff09\uff0c\u4f46\u4ed6\u5766\u8a00\u4ed6\u5728\u5176\u4e2d\u4e26\u4e0d\u8aa0\u5be6\uff08\u3008\u7570\u8c61\u7bc7\u30092.3.1[7\uff1a1]; \u3008\u547d\u4ee4\u7bc7\u30093.3[28\uff1a3]\uff09\uff0c\u6536\u5165\u53ef\u89c0\uff08\u3008\u7570\u8c61\u7bc7\u30093.6.7[14\uff1a7]\uff09\u3002 \u4fc4\u5229\u6839\u5728\u4ed6\u7684\u300a\u7f85\u99ac\u66f8\u8a3b\u91cb\u300b\u4e2d\uff0c\u5c07\u672c\u66f8\u7684\u4f5c\u8005\u8207\u7f85\u5341\u516d14\u4e2d\u7684\u9ed1\u7c73\uff0c\u770b\u70ba\u662f\u540c\u4e00\u4eba\uff0c\u4f46\u9664\u4e86\u540d\u5b57\u76f8\u4f3c\u5916\uff0c\u6c92\u6709\u4efb\u4f55\u5176\u5b83\u8b49\u660e\u3002 <br\/><br\/>\u6709\u5b78\u8005\uff08\u5982Dibelius\uff09\u8a8d\u70ba\u672c\u66f8\u4f5c\u8005\u7684\u81ea\u8ff0\uff0c\u5168\u662f\u865b\u69cb\u7684\uff0c\u53ea\u662f\u5bd3\u610f\u3002 \u300a\u7a46\u62c9\u591a\u5229\u6b98\u7bc7\u300b\u6307\u672c\u66f8\u7684\u4f5c\u8005\u662f\u65b0\u8fd1\u7f85\u99ac\u4e3b\u6559\u5e87\u8b77\uff08Pius\uff09\u7684\u5144\u5f1f\u9ed1\u99ac\u6240\u5beb\uff08\u897f\u5143140\u5e74\uff09\uff0c\u7136\u800c\u672c\u66f8\u61c9\u662f\u5beb\u65bc\u66f4\u65e9\u6642\u671f\u3002 \u82e5\u672c\u66f8\u4f5c\u8005\u662f\u81ea\u8ff0\u4e2d\u7684\u9ed1\u99ac\uff0c\u4ed6\u5927\u6982\u6c92\u6709\u53d7\u904e\u6b63\u5f0f\u7684\u6559\u80b2\uff0c\u5728\u6587\u5b78\u548c\u795e\u5b78\u4e0a\uff0c\u90fd\u6c92\u6709\u5f88\u5091\u51fa\u7684\u8868\u73fe\uff0c\u7136\u800c\u4ed6\u80fd\u8b80\u80fd\u5beb\uff0c\u56e0\u70ba\u4ed6\u4e26\u975e\u6587\u4eba\u6216\u8cb4\u65cf\u51fa\u8eab\uff0c\u6240\u4ee5\u66f4\u80fd\u53cd\u6620\u51fa\u7576\u6642\u4e00\u822c\u5e73\u6c11\u767e\u59d3\u7684\u5fc3\u614b\u3002 <br\/><br\/>\u53e6\u4e00\u5047\u8aaa\u662f\u57fa\u65bc\u672c\u66f8\u5404\u90e8\u5206\u7528\u5b57\u7684\u4e0d\u540c\uff0c\u53ca\u795e\u5b78\u89c0\u5ff5\u4e0a\u7684\u4e0d\u7d71\u4e00\uff0c\u8a8d\u70ba\u6b64\u66f8\u662f\u7d93\u904e\u4e0d\u540c\u968e\u6bb5\uff0c\u7531\u4e0d\u540c\u4f5c\u8005\u6240\u5beb\u6210\uff0c\u6700\u5f8c\u7531\u4e00\u4f4d\u4f5c\u70ba\u7de8\u8f2f\uff0c\u5c07\u4e4b\u7d50\u96c6\u6210\u66f8\uff08S. Giet\uff09\u3002 \u53e6\u4e00\u7a2e\u53ef\u80fd\u5c31\u662f\u5167\u4e2d\u6709\u4e0d\u540c\u7684\u50b3\u7d71\uff0c\u7531\u4e00\u4f4d\u4f5c\u8005\u96c6\u5176\u5927\u6210\u3002 \u7c73\u9ad8\u65af\uff08Michaels\uff09\u5c31\u6307\u51fa\u672c\u66f8\u66fe\u4f7f\u7528\u7336\u592a\u88d4\u57fa\u7763\u5f92\u7684\u50b3\u7d71\uff0c\u6839\u64da\u7b2c\u4e09\u4e16\u7d00\u7f85\u99ac\u4e3b\u6559\u5e0c\u5761\u5f8b\u9640\uff08Hippolytus\uff09\u7684\u8a18\u8ff0\uff0c\u4e00\u4f4d\u540d\u70ba\u611b\u723e\u514b\u8cfd\uff08Elkesai\uff0c\u6642\u7d04\u897f\u5143100\u5e74\uff09\u7684\u7336\u592a\u88d4\u57fa\u7763\u5f92\uff08\u4f0a\u4fbf\u5c3c\u6d3e\u4eba\u58eb\uff09\uff0c\u66fe\u5ba3\u544a\u7f85\u99ac\u7687\u5e1d\u4ed6\u96c5\u52aa\uff08\u897f\u514353-117\u5e74\uff09\u5728\u4f4d\u7b2c\u4e09\u5e74\uff0c\u70ba\u8056\u5f92\u6094\u6539\u7684\u9650\u671f\uff0c\u9019\u671f\u9650\u7684\u8aaa\u6cd5\uff0c\u4ea6\u898b\u65bc\u300a\u9ed1\u99ac\u7267\u4eba\u66f8\u300b\uff08\u3008\u7570\u8c61\u7bc7\u3009 2.2.4-5[6\uff1a4-5]\uff09\uff0c\u4f46\u9019\u96bb\u662f\u5c0d\u9019\u6bb5\u8aaa\u8a71\u4e00\u500b\u53ef\u80fd\u7684\u89e3\u91cb\u3002<br\/><br\/>\u4ea6\u6709\u8a8d\u70ba\u672c\u66f8\u7528\u5b57\u7684\u4e0d\u540c\u662f\u56e0\u70ba\u4f5c\u8005\u4f7f\u7528\u4e0d\u540c\u7684\u6587\u9ad4\uff0c\u8655\u7406\u4e0d\u540c\u7684\u4e3b\u984c\uff0c\u66f8\u4e2d\u4ea6\u6709\u5f88\u591a\u7d71\u4e00\u7684\u601d\u60f3\uff0c\u800c\u4e14\u6c92\u6709\u8b49\u64da\u986f\u793a\u6709\u7de8\u8f2f\u8005\u8a66\u5716\u8abf\u5354\u5176\u4e2d\u7684\u77db\u76fe\u4f5c\uff08Wilson\uff09\u3002 \u6211\u5011\u53ea\u53ef\u4ee5\u8aaa\u300a\u9ed1\u99ac\u7267\u4eba\u66f8\u300b\u4e2d\u6709\u4e0d\u540c\u7684\u50b3\u7d71\uff0c\u5305\u62ec\u7336\u592a\u3001\u5e0c\u7f85\u53ca\u57fa\u7763\u6559\u8457\u4f5c\u7684\u50b3\u7d71\uff08Osiek\uff09\uff0c\u96e3\u4ee5\u78ba\u5b9a\u672c\u66f8\u662f\u51fa\u81ea\u4e00\u4eba\u7684\u624b\u7b46\uff0c\u6709\u5f85\u66f4\u591a\u7684\u7814\u7a76\u3002<br\/><br\/><h2>\u5beb\u4f5c\u65e5\u671f\u53ca\u5730\u9ede<\/h2><br\/>\u9019\u66f8\u6975\u53ef\u80fd\u662f\u5beb\u65bc\u7f85\u99ac\u57ce\uff0c\u56e0\u70ba\u5176\u5167\u5bb9\u53cd\u6620\u51fa\u7f85\u99ac\u6559\u6703\u7684\u751f\u6d3b\uff0c\u7279\u5225\u662f\u66f8\u4e2d\u63d0\u53ca\u5f9e\u653f\u6b0a\u800c\u4f86\u7684\u8feb\u5bb3\uff087\uff1a4[\u3008\u7570\u8c61\u7bc7\u30092.3.4]; 50\uff1a6\uff0c98\uff1a3\uff0c105\uff1a2-6\uff0c114\uff1a3[\u3008\u6bd4\u55bb\u7bc7\u30091.6\uff0c9.21.3\uff0c9.28.2-6\uff0c10.4.3]\uff09\u3002 \u82e5\u672c\u66f8\u662f\u4e00\u4eba\u5beb\u6210\uff0c\u5247\u53ef\u80fd\u5beb\u65bc\u5c3c\u9304\u738b\u6642\u671f\uff08\u897f\u514354-68\u5e74\uff09\uff0c\u7576\u6642\u7f85\u99ac\u57fa\u7763\u6559\u6703\u66fe\u9762\u5c0d\u903c\u8feb\uff0c\u4fdd\u7f85\u4ea6\u5728\u5c3c\u9304\u5728\u4f4d\u671f\u9593\u88ab\u8655\u6b7b\uff08\u897f\u514364-68\u5e74\uff09\u3002 \u82e5\u672c\u66f8\u662f\u7d93\u904e\u4e0d\u540c\u7684\u968e\u6bb5\u7de8\u8f2f\u6210\u66f8\uff0c\u6709\u4e00\u8aaa\u6cd5\u8a8d\u70ba\u672c\u66f8\u7b2c1\u81f324\u7ae0\uff08\u3008\u7570\u8c61\u7bc7\u30091-4[1-24]\uff09\u53cd\u6620\u51fa\u5728\u5c3c\u9304\u738b\u548c\u591a\u7c73\u7530\uff08\u897f\u514381-96\u5e74\uff09\u6cbb\u4e0b\u6559\u6703\u53d7\u903c\u8feb\u7684\u60c5\u6cc1\uff0c\u7b2c25\u81f3114\u7ae0\u53ef\u80fd\u662f\u7b2c\u4e8c\u4e16\u7d00\u4e2d\u8449\u7684\u4f5c\u54c1\uff0c\u5176\u4e2d\u7b2c78\u81f3114\u7ae0\uff0878-114[\u3008\u6bd4\u55bb\u7bc7\u30099-10]\uff09\u53ef\u80fd\u662f\u5f8c\u52a0\u7684\u3002 \u6709\u8a8d\u70ba8\uff1a3[\u3008\u7570\u8c61\u7bc7\u30092.4.3]\u4e2d\u63d0\u53ca\u6709\u4e00\u4f4d\u53eb\u9769\u5229\u514d\u7684\uff0c\u4ed6\u4ee5\u5c07\u67d0\u4e9b\u8457\u4f5c\u50b3\u9054\u5230\u5404\u8655\u70ba\u5df1\u4efb\uff0c\u82e5\u9019\u662f\u7f85\u99ac\u4e3b\u6559\u9769\u5229\u514d\uff0c\u6b64\u66f8\u4fbf\u662f\u7b2c\u4e00\u4e16\u7d00\u672b\u4e4b\u5f8c\u7684\u4f5c\u54c1\u3002 \u4f46\u4e0d\u78ba\u5b9a\u9019\u4eba\u662f\u5426\u7f85\u99ac\u7684\u4e3b\u6559\uff0c\u6545\u751a\u96e3\u4ee5\u6b64\u65b7\u5b9a\u3002 \u672c\u66f8\u6240\u63cf\u8ff0\u7684\u7f85\u99ac\u6559\u6703\uff0c\u662f\u96c6\u9ad4\u9577\u8001\u7ba1\u7406\u7684\u5236\u5ea6\u800c\u975e\u7368\u4e00\u4e3b\u6559\u5236\uff088\uff1a3[\u3008\u7570\u8c61\u7bc7\u30092.4.3]; \u53c36\uff1a6\uff0c17\uff1a7-8[2.2.6\uff0c3.9.7-8]\uff09\uff0c\u53cd\u6620\u51fa\u8f03\u65e9\u671f\u7f85\u99ac\u6559\u6703\u7684\u60c5\u6cc1\u3002 \u4e26\u4e14\u66f8\u4e2d\u4f3c\u4e4e\u6709\u91dd\u5c0d\u8afe\u65af\u5e95\u4e3b\u7fa9\u7684\u8a00\u8ad6\uff0860\uff1a1\u30014[\u3008\u6bd4\u55bb\u7bc7\u30095.7.1\u30014]\uff09\uff0c\u4f46\u537b\u672a\u6709\u4efb\u4f55\u6d89\u53ca\u5b5f\u4ed6\u52aa\u4e3b\u7fa9\u7684\u8a00\u8ad6\uff0c\u5b5f\u4ed6\u52aa\u4e3b\u7fa9\u7d04\u5728\u897f\u5143135\u5e74\u5de6\u53f3\u5f71\u97ff\u5230\u7f85\u99ac\uff0c\u56e0\u6b64\u6b64\u66f8\u5f88\u53ef\u80fd\u6700\u7d42\u5b8c\u6210\u65bc\u6b64\u6642\u671f\uff08Jeffers\uff09\u3002<br\/><br\/><h2>\u5beb\u4f5c\u76ee\u7684<\/h2><br\/>\u6574\u5377\u66f8\u90fd\u5f37\u8abf\u57fa\u7763\u5f92\u7684\u9053\u5fb7\u64cd\u5b88\uff0c\u7279\u5225\u662f\u61c9\u5982\u4f55\u8655\u7406\u53d7\u6d17\u4e4b\u5f8c\u518d\u6b21\u58ae\u5165\u7f6a\u4e2d\u7684\u554f\u984c\u3002 \u7576\u6642\u6709\u4e00\u7a2e\u8aaa\u6cd5\u8a8d\u70ba\u82e5\u4e00\u500b\u4eba\u5728\u53d7\u6d17\u4e4b\u5f8c\uff0c\u53c8\u91cd\u65b0\u58ae\u5165\u72af\u7f6a\u7684\u751f\u6d3b\uff0c\u4fbf\u6703\u55aa\u5931\u6551\u6069\uff0c\u4e0d\u53ef\u91cd\u65b0\u61ca\u6094\uff08\u53c3\u4f866\uff1a4-6\uff09\uff0c\u7136\u800c\u672c\u66f8\u5247\u8a8d\u70ba\u7b2c\u4e8c\u6b21\u6094\u6539\u662f\u53ef\u80fd\u7684\uff0c\u4f46\u53ea\u6709\u591a\u4e00\u6b21\u7684\u6a5f\u6703\uff0c\u82e5\u7136\u4e0d\u638c\u63e1\u9019\u6a5f\u6703\uff0c\u4fbf\u518d\u6c92\u6709\u4efb\u4f55\u76fc\u671b\u53ef\u8a00\uff0c\u9019\u7b2c\u4e8c\u6b21\u7684\u6094\u6539\uff0c\u53eb\u4eba\u5f97\u4ee5\u514d\u53bb\u90a3\u672b\u65e5\u5929\u555f\u5be9\u5224\u6240\u5e36\u4f86\u7684\u75db\u82e6\u3002 \u672c\u66f8\u9f13\u52f5\u5728\u903c\u8feb\u548c\u8a66\u7149\u4e2d\u7684\u4fe1\u5f92\uff0c\u85c9\u8457\u8056\u9748\u5fe0\u5fc3\u5fcd\u8010\uff0c\u904e\u8056\u6f54\u7684\u751f\u6d3b\uff0c\u8207\u5225\u4eba\u5efa\u7acb\u5fe0\u8aa0\u7684\u95dc\u4fc2\uff0c\u6297\u62d2\u7570\u7aef\u7684\u8a98\u60d1; \u6559\u6703\u88e1\u6709\u5fe0\u5fc3\uff08\u516c\u7fa9\uff09\u4ea6\u6709\u4e0d\u90a3\u9ebc\u5fe0\u5fc3\uff08\u72af\u7f6a\uff09\u7684\u4fe1\u5f92\uff0c\u6700\u5f8c\u4e3b\u5fc5\u5be9\u5224\u3002<br\/><br\/><h2>\u9ad4\u88c1\u53ca\u5167\u5bb9\u6982\u8981<\/h2><br\/>\u672c\u66f8\u8072\u7a31\u5176\u5167\u5bb9\uff0c\u4e0d\u8ad6\u662f\u3008\u7570\u8c61\u7bc7\u3009\uff08\u7b2c1-25\u7ae0\uff09\u3001\u3008\u547d\u4ee4\u7bc7\u3009\uff08\u7b2c26-49\u7ae0\uff09\u3001\u9084\u662f\u3008\u6bd4\u55bb\u7bc7\u3009\uff08\u7b2c50-114\u7ae0\uff09\uff0c\u90fd\u662f\u6e90\u81ea\u9ed1\u99ac\u5f9e\u5929\u4e0a\u800c\u5f97\u7684\u555f\u793a\uff0c\u9019\u4e09\u90e8\u5206\u7684\u95dc\u4fc2\u4e26\u4e0d\u7dca\u5bc6\uff0c\u4e3b\u984c\u537b\u4e0d\u6642\u91cd\u8907\u3002 \u4e3b\u8981\u7684\u555f\u793a\u8005\u662f\u7267\u4eba\uff0c\u6b64\u5916\u9084\u6709\u4f86\u81ea\u5176\u5b83\u5929\u4f7f\uff0c\u53ca\u4e00\u540d\u8c61\u5fb5\u6559\u6703\u7684\u8001\u5a66\u4eba\u7684\u6559\u5c0e\uff0c\u9ed1\u99ac\u53ea\u662f\u4e00\u500b\u8a18\u6558\u548c\u50b3\u8a00\u7684\u4eba\u3002 \u9019\u7a2e\u4ee5\u7b2c\u4e00\u4eba\u7a31\u900f\u904e\u5929\u4f7f\u7684\u555f\u793a\u5f97\u898b\u5929\u754c\u5883\u8c61\u7684\u6558\u8ff0\uff0c\u986f\u660e\u672c\u66f8\u5c6c\u65bc\u5929\u555f\u6587\u5b78\u3002 \u5176\u4e2d\u3008\u6bd4\u55bb\u7bc7\u3009\u5be6\u975e\u771f\u6b63\u7684\u6bd4\u55bb\uff0c\u6709\u9ede\u50cf\u3008\u4ee5\u8afe\u7684\u6bd4\u55bb\u3009\uff08Similitude of Enoch\uff09\uff0c\u90fd\u662f\u9ed1\u99ac\u5728\u7570\u8c61\u4e2d\u7267\u4eba\u5411\u4ed6\u5c55\u73fe\u5e36\u6709\u8c61\u5fb5\u6027\u610f\u7fa9\u7684\u5883\u8c61\u3002 <br\/><br\/>\u3008\u7570\u8c61\u7bc7\u3009\u8a18\u8f09\u9ed1\u99ac\u6240\u898b\u7684\u4e94\u500b\u7570\u8c61\uff081-4\uff0c5-8\uff0c9-21\uff0c22-24\uff0c25\uff09\uff0c\u5728\u9996\u56db\u500b\u7570\u8c61\u4e2d\uff0c\u4ed6\u6240\u9047\u898b\u7684\u8001\u5a66\u4eba\u3001\u5c11\u5a66\u4eba\u3001\u5e74\u9752\u4eba\u548c\u65b0\u5a66\uff0c\u90fd\u662f\u6559\u6703\u7684\u8c61\u5fb5\uff0c\u5230\u7b2c\u4e94\u500b\u7570\u8c61\uff0c\u7267\u4eba\u4fbf\u51fa\u73fe\uff0c\u4ed6\u662f\u53eb\u4eba\u6094\u6539\u7684\u5929\u4f7f\uff0c\u4ed6\u5429\u5490\u9ed1\u99ac\u8981\u7559\u4e0b\u4f86\uff0c\u4ed6\u8981\u50b3\u6388\u9ed1\u99ac\u547d\u4ee4\u548c\u6bd4\u55bb\uff0c\u9ed1\u99ac\u8981\u5c07\u9019\u4e9b\u90fd\u5beb\u4e0b\u4f86\u3002 \u7b2c\u4e94\u500b\u7570\u8c61\u4fbf\u6210\u70ba\u3008\u547d\u4ee4\u7bc7\u3009\u548c\u3008\u6bd4\u55bb\u7bc7\u3009\u7684\u5f15\u8a00\u3002 \u9019\u4ea6\u53cd\u6620\u65bc\u79d1\u666e\u66ff\u7248\u672c\u548c\u84b2\u8349\u5377129\uff0c\u53ca\u5176\u4ed6\u6559\u7236\u7684\u5f15\u8ff0\uff0c\u90fd\u662f\u4ee5\u4ee5\u7b2c\u4e94\u500b\u7570\u8c61\u4f5c\u70ba\u958b\u59cb\u3002<br\/><br\/>\u9019\u4e9b\u6bd4\u55bb\u5728\u5929\u555f\u6587\u737b\u4e2d\u53ef\u4ee5\u8aaa\u662f\u76f8\u7576\u7368\u7279\u7684\uff0c\u56e0\u70ba\u4f5c\u8005\u4e26\u6c92\u6709\u8a17\u5176\u4ed6\u4e0a\u53e4\u6709\u540d\u5049\u4eba\u7684\u540d\u5b57\u5beb\u4e0b\u9019\u4e9b\u7570\u8c61\uff0c\u800c\u662f\u4ee5\u81ea\u5df1\u7684\u540d\u7fa9\u5c07\u4e4b\u8a18\u4e0b\u3002 \u958b\u59cb\u6642\u4ed6\u4ee5\u81ea\u8ff0\u7684\u65b9\u5f0f\uff0c\u4ecb\u7d39\u81ea\u5df1\u66fe\u5728\u7f85\u99ac\u7576\u5974\u96b8\uff0c\u4ed6\u7684\u524d\u4e3b\u4eba\u662f\u4e00\u4f4d\u540d\u53eb\u7f85\u5927\u7684\u5973\u6027\uff0c\u9ed1\u99ac\u8868\u9054\u5c0d\u5979\u7684\u50be\u6155\u3002 \u7136\u800c\u7f85\u5927\u5728\u7570\u8c61\u4e2d\u8cac\u5099\u4ed6\u4e0d\u61c9\u5b58\u9019\u975e\u5206\u4e4b\u60f3\uff0c\u8b66\u544a\u4ed6\u8981\u6094\u6539\uff081\uff1a1-9[\u3008\u7570\u8c61\u7bc7\u30091.1.1-9]\uff09\u3002 \u63a5\u8457\u7684\u4e09\u500b\u7570\u8c61\uff0c\u6709\u4e00\u4f4d\u8c61\u5fb5\u6559\u6703\u7684\u8001\u5a66\u4eba\u51fa\u73fe\uff0c\u4ed6\u5411\u6cae\u55aa\u7684\u9ed1\u99ac\u4fdd\u8b49\u4ed6\u7684\u7f6a\u5c1a\u672a\u6709\u771f\u6b63\u5730\u5be6\u73fe\uff0c\u7136\u800c\u4ed6\u8981\u6094\u6539\uff0c\u4e0d\u53ea\u4ed6\u81ea\u5df1\uff0c\u5c31\u662f\u4ed6\u7684\u5bb6\u4eba\uff0c\u4e5f\u8981\u70ba\u7f6a\u6094\u904e\uff082\uff1a1-4\uff1a3[1.2.1-1.4.3]\uff09\u3002 \u5728\u7b2c\u4e8c\u500b\u7570\u8c61\u4e2d\uff0c\u90a3\u8001\u5a66\u4eba\u5411\u9ed1\u99ac\u8aaa\u660e\u90a3\u4e9b\u72af\u7f6a\u7684\u57fa\u7763\u5f92\uff0c\u53ef\u4ee5\u5728\u4e00\u5b9a\u7684\u6642\u9650\u4e4b\u5167\u6094\u6539\uff0c\u5728\u6b64\u4e4b\u524d\u4ed6\u5011\u7684\u7f6a\u53ef\u5f97\u8d66\u514d\uff0c\u4e0d\u7136\u4fbf\u6703\u5931\u53bb\u6551\u6069\uff086\uff1a5[2.2.5]\uff09\u3002 \u5728\u7b2c\u4e09\u500b\u7570\u8c61\u4e2d\uff0c\u9ed1\u99ac\u770b\u898b\u6709\u4e03\u4f4d\u9752\u5e74\uff08\u8c61\u5fb5\u5929\u4f7f\uff09\uff0c\u5728\u6c34\u4e2d\uff08\u8c61\u5fb5\u6c34\u79ae\uff09\u8208\u5efa\u4e00\u5ea7\u5854\uff0c\u5c31\u597d\u50cf\u90a3\u8001\u5a66\u4eba\u4e00\u6a23\uff0c\u9019\u5854\u4ee3\u8868\u6559\u6703\uff0c\u90a3\u4e9b\u7528\u4f5c\u5efa\u9020\u5854\u7684\u77f3\u982d\u4ee3\u8868\u5404\u5f0f\u5404\u6a23\u7684\u57fa\u7763\u5f92\uff0c\u7136\u800c\u6709\u4e9b\u662f\u5408\u7528\u7684\uff0c\u6709\u4e9b\u5247\u4e0d\u4e2d\u7528\uff0c\u4ee5\u81f4\u88ab\u4e1f\u68c4\uff0c\u8c61\u5fb5\u8457\u5fe0\u5fc3\u7684\u4fe1\u5f92\u548c\u4e0d\u6cd5\u4e4b\u5b50\u3002 \u90a3\u4e9b\u6c92\u6709\u88ab\u4e1f\u5f97\u592a\u9060\u7684\u77f3\u982d\uff0c\u4ee3\u8868\u90a3\u4e9b\u72af\u7f6a\u7684\u4fe1\u5f92\uff0c\u4ed6\u5011\u82e5\u6094\u6539\uff0c\u5fc5\u88ab\u633d\u56de\uff0c\u518d\u88ab\u4f7f\u7528\u3002 \u570d\u7e5e\u8457\u90a3\u5854\u6709\u4e03\u500b\u5a66\u4eba\uff0c\u4ee3\u8868\u4e03\u500b\u54c1\u5fb7\uff1a\u4fe1\u5fc3\u3001\u7bc0\u5236\u3001\u771f\u8aa0\u3001\u77e5\u8b58\u3001\u7d14\u771f\u3001\u656c\u754f\u548c\u611b\uff0c\u9019\u4e9b\u90fd\u662f\u5c6c\u65bc\u90a3\u4e9b\u5c6c\u9019\u5854\u7684\u4eba\u3002 \u5728\u7b2c\u56db\u500b\u7570\u8c61\uff0c\u9ed1\u99ac\u770b\u898b\u4e00\u96bb\u5de8\u7378\uff0c\u5b83\u7684\u982d\u6709\u56db\u7a2e\u984f\u8272\uff08\u9ed1\u3001\u706b\u8207\u8840\u7684\u984f\u8272\u3001\u91d1\u3001\u767d\uff09\uff0c\u9019\u7378\u4ee3\u8868\u5c07\u81e8\u7684\u8feb\u5bb3\uff0c\u60df\u6709\u5fe0\u5fc3\uff0c\u4e0d\u5fc3\u61f7\u4e8c\u610f\u7684\u4eba\u624d\u53ef\u514b\u670d\u3002 \u9ed1\u99ac\u5728\u7b2c\u4e94\u500b\u7570\u8c61\u4e2d\u9047\u898b\u7267\u4eba\uff0c\u7267\u4eba\u6703\u5411\u9ed1\u99ac\u5c55\u793a\u548c\u89e3\u91cb\u547d\u4ee4\u548c\u6bd4\u55bb\u3002 \u9019\u7267\u4eba\u96d6\u7136\u57f7\u884c\u4e00\u4e9b\u985e\u4f3c\u57fa\u7763\u6240\u4f5c\u7684\u5de5\u4f5c\uff0c\u4f46\u4ed6\u4e26\u975e\u57fa\u7763\uff0c\u9019\u7267\u4eba\u662f\u53eb\u4eba\u6094\u6539\u7684\u5929\u4f7f\uff08\u598225\uff1a7[\u3008\u7570\u8c61\u7bc7\u30095.7]; 47\uff1a7[\u3008\u547d\u4ee4\u7bc7\u300912.4.7]\uff09\u3002\u3008\u547d\u4ee4\u7bc7\u3009\u7684\u5341\u4e8c\u6bb5\uff0826\uff0c27\uff0c28\uff0c29-32\uff0c33-34\uff0c35-36\uff0c37\uff0c38\uff0c39\uff0c40-42\uff0c43\uff0c44\uff1a1-46\uff1a1\uff09\u95e1\u91cb\u4e00\u9023\u4e32\u7684\u5fb7\u884c\uff1a\u4fe1\u4e0a\u5e1d\u3001\u771f\u8aa0\u53ca\u6e05\u767d\u3001\u611b\u6155\u771f\u5be6\u3001\u7d14\u6f54\u3001\u5728\u82e6\u96e3\u4e2d\u7684\u5fcd\u8010\u3001\u4fe1\u5fc3\u3001\u656c\u754f\u3001\u81ea\u88fd\u3002 \u4e26\u4e14\u8981\u9632\u907f\u61f7\u7591\u8207\u5fc3\u61f7\u4e8c\u610f\u3001\u6182\u6101\u3001\u5047\u5148\u77e5\u3001\u548c\u90aa\u60e1\u7684\u617e\u671b\u3002 \u5176\u4e2d\u8655\u7406\u7684\u8ab2\u984c\u5305\u62ec\u96e2\u5a5a\uff0c\u7b2c\u4e8c\u6b21\u7684\u5a5a\u59fb\uff0c\u8003\u9a57\u5047\u6559\u5e2b\u3002 \u4e26\u4e14\u4f7f\u7528\u4e86\u597d\u50cf\u300a\u5df4\u62ff\u5df4\u66f8\u4fe1\u300b\u548c\u300a\u5341\u4e8c\u4f7f\u5f92\u907a\u8a13\u300b\u4e2d\u201c\u5169\u689d\u8def\u201d\u7684\u50b3\u7d71\uff0c\u4e26\u4e14\u4f7f\u7528\u63a5\u8fd1\u6b7b\u6d77\u6587\u737b\u7684\u300a\u7fa4\u9ad4\u5b88\u5247\u300b\uff081QS\uff09\u5169\u500b\u9748\u7684\u50b3\u7d71\uff0c\u6709\u5169\u500b\u5929\u4f7f\/\u9748\u5728\u4eba\u751f\u547d\u4e2d\u7684\u5de5\u4f5c\uff0c\u4e00\u500b\u70ba\u5584\uff0c\u4e00\u500b\u70ba\u60e1\uff0836\uff1a2\uff0c43\uff1a11[\u3008\u547d\u4ee4\u7bc7\u30096.2\uff0c11.11]\uff09\u3002 \u76ee\u7684\u662f\u8981\u8aac\u660e\u4fe1\u5f92\u77e5\u9053\u5169\u8005\u7684\u5206\u5225\uff0c\u53ca\u5982\u4f55\u64c7\u5584\u56fa\u57f7\u3002\u3008\u6bd4\u55bb\u7bc7\u3009\u7684\u5341\u500b\u6bd4\u55bb\u662f\u7267\u4eba\u6307\u793a\u9ed1\u99ac\uff0c\u5982\u4f55\u7406\u89e3\u3008\u7570\u8c61\u7bc7\u3009\u548c\u3008\u547d\u4ee4\u7bc7\u3009\u7684\u6559\u5c0e\u3002 \u9019\u4e5d\u500b\u6bd4\u55bb\u5206\u5225\u70ba\u5169\u500b\u57ce\u5e02\uff08\u6709\u95dc\u57fa\u7763\u5f92\u4f5c\u70ba\u5929\u4e0a\u7684\u516c\u6c11; \u7b2c50\u7ae0\uff09\u3001\u8461\u8404\u6a39\u548c\u6986\u6a39\uff08\u6709\u95dc\u8ca7\u5bcc\u4e4b\u9593\u7684\u95dc\u4fc2; \u7b2c51\u7ae0\uff09\u3001\u51ac\u5929\u7684\u6a39\uff08\u7b2c52\u7ae0\uff09\u548c\u590f\u5929\u7684\u6a39\uff08\u9019\u5169\u500b\u6bd4\u55bb\u5c0d\u6bd4\u7fa9\u4eba\u548c\u7f6a\u4eba\uff0c\u5728\u4f86\u4e16\u7684\u201c\u590f\u5929\u201d\uff0c\u4e00\u5207\u4fbf\u6703\u986f\u9732; \u7b2c53\u7ae0\uff09\u3001\u8461\u8404\u5712\u7684\u5de5\u4eba\uff08\u57fa\u7763\u5f92\u4f5c\u70ba\u6240\u8cdc\u4e88\u7684\u9748\u4e4b\u7ba1\u5bb6\u7684\u8077\u5206; \u7b2c54-60\u7ae0\uff09\u3001\u5169\u500b\u7267\u4eba\uff08\u5962\u4f88\u548c\u6b3a\u9a19\u7684\u7d50\u679c\u662f\u56b4\u53b2\u7684\u61f2\u7f70; \u7b2c61-65\u7ae0\uff09\u3001\u67f3\u6a39\uff08\u5404\u5f0f\u5404\u6a23\u4e0d\u540c\u7684\u4fe1\u5f92\uff0c\u4ed6\u5011\u4e4b\u9593\u7684\u5206\u5225\u5728\u65bc\u5982\u4f55\u4f7f\u7528\u4ed6\u5011\u7684\u6069\u8cdc\uff0c\u4e26\u4ed6\u5011\u5982\u4f55\u6094\u6539; \u7b2c67-77\u7ae0\uff09\u3001\u4ee5\u53ca\u773e\u5c71\u548c\u5854\uff08\u6559\u6703\u4e26\u5176\u4e2d\u7684\u4fe1\u5f92; \u7b2c78-110\u7ae0\uff09\u3002 \u6700\u5f8c\u7b2c\u5341\u500b\u6bd4\u55bb\u662f\u7e3d\u7d50\u6027\u7684\u6307\u5c0e\uff08\u7b2c111-114\u7ae0\uff09\u3002<br\/><br\/><h2>\u88dc\u5145\u53c3\u8003\uff1a<\/h2><br\/>James S. Jeffers\uff0c\u7f85\u99ac\u885d\u7a81\uff1a\u65e9\u671f\u57fa\u7763\u6559\u7684\u793e\u6703\u79e9\u5e8f\u548c\u7b49\u7d1a\u5236\u5ea6\u3002\u660e\u5c3c\u963f\u6ce2\u5229\u65af\uff1a\u5821\u58d8\uff0c1991\u5e74\u3002 M. Dibelius\uff0c Der Hirt des Hermas\uff08HNT 20\uff0c1923\uff09; G. F. Synder\uff0c The Shepherd of Hermas.\uff08The Apostolic Fathers 6\uff0c1968\uff09; \u540c\u4e0a\u4f5c\u8005\uff0cABD 3\uff1a148;E. M. Humphrey\uff0c The Ladies and the Cities\uff08JSPSup 17; 1995\uff09; J. C. Wilson\uff0c Five Problems in the Interpretation of the Shepherd of Hermas\uff08MBPS 34\uff0c1996\uff09; S. Giet\uff0c  Hermas et les Pasteurs\uff1a Les Trios auteurs du Pasteur d'Hermas .\u5df4\u9ece\uff1a\u6cd5\u862d\u897f\u5927\u5b78\u51fa\u7248\u793e\uff0c1963\u5e74; C. \u5967\u897f\u514b\uff0c\u300a\u8d6b\u723e\u99ac\u65af\u7684\u7267\u7f8a\u4eba\u300b\uff08Hermeneia\uff0c1999\u5e74\uff09\u3002"},
